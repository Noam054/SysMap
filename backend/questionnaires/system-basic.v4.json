{
  "id": "system-basic",
  "version": 4,
  "title": "Basic system information",
  "questions": [
    {
      "id": "system_name",
      "type": "text",
      "label": "What is the name of your system?",
      "required": true
    },
    {
      "id": "primary_site",
      "type": "choice",
      "label": "Which is your system's primary site?",
      "required": true,
      "options": [
        "Ofek",
        "Sapir",
        "Mazpen"
      ]
    },
    {
      "id": "segments",
      "type": "list",
      "label": "Network segments in your primary site",
      "row_label": "Segment",
      "help": "Add each network segment (subnet) of your system. Servers are placed in these segments.",
      "item": [
        {
          "id": "name",
          "type": "text",
          "label": "Segment name",
          "required": true,
          "placeholder": "e.g. DMZ",
          "help": "Segment names must be different within a site.",
          "distinct": true
        },
        {
          "id": "subnet",
          "type": "text",
          "label": "Subnet",
          "required": true,
          "format": "cidr",
          "placeholder": "e.g. 14.151.0.0/24"
        }
      ]
    },
    {
      "id": "servers",
      "type": "list",
      "label": "Servers in your primary site",
      "row_label": "Server",
      "item": [
        {
          "id": "name",
          "type": "text",
          "label": "Server name",
          "required": true,
          "help": "Server names must be different within a site, and different from the site's segment names. Another site may have a server with the same name.",
          "distinct": true,
          "not_in": [
            "segments.name"
          ]
        },
        {
          "id": "role",
          "type": "choice",
          "label": "Role",
          "options": [
            "web",
            "app",
            "database",
            "storage",
            "other"
          ]
        },
        {
          "id": "os",
          "type": "choice",
          "label": "Operating system",
          "options": [
            "Windows",
            "Linux"
          ]
        },
        {
          "id": "segment",
          "type": "choice",
          "label": "Network segment",
          "options_from": "segments.name",
          "help": "One of the segments above (add a segment first to choose one)."
        }
      ],
      "duplicate": true,
      "copy_from_site": true
    },
    {
      "id": "other_sites",
      "type": "list",
      "label": "Other sites",
      "row_label": "Site",
      "start_empty": true,
      "help": "Does your system have servers in another site? Press “Add site” for each one.",
      "item": [
        {
          "id": "site",
          "type": "choice",
          "label": "Which site?",
          "required": true,
          "options": [
            "Ofek",
            "Sapir",
            "Mazpen"
          ],
          "exclude": [
            "/primary_site",
            "/other_sites.site"
          ]
        },
        {
          "id": "segments",
          "type": "list",
          "label": "Network segments in this site",
          "row_label": "Segment",
          "help": "Add each network segment (subnet) of your system. Servers are placed in these segments.",
          "item": [
            {
              "id": "name",
              "type": "text",
              "label": "Segment name",
              "required": true,
              "placeholder": "e.g. DMZ",
              "help": "Segment names must be different within a site.",
              "distinct": true
            },
            {
              "id": "subnet",
              "type": "text",
              "label": "Subnet",
              "required": true,
              "format": "cidr",
              "placeholder": "e.g. 14.151.0.0/24"
            }
          ]
        },
        {
          "id": "servers",
          "type": "list",
          "label": "Servers in this site",
          "row_label": "Server",
          "item": [
            {
              "id": "name",
              "type": "text",
              "label": "Server name",
              "required": true,
              "help": "Server names must be different within a site, and different from the site's segment names. Another site may have a server with the same name.",
              "distinct": true,
              "not_in": [
                "segments.name"
              ]
            },
            {
              "id": "role",
              "type": "choice",
              "label": "Role",
              "options": [
                "web",
                "app",
                "database",
                "storage",
                "other"
              ]
            },
            {
              "id": "os",
              "type": "choice",
              "label": "Operating system",
              "options": [
                "Windows",
                "Linux"
              ]
            },
            {
              "id": "segment",
              "type": "choice",
              "label": "Network segment",
              "options_from": "segments.name",
              "help": "One of the segments above (add a segment first to choose one)."
            }
          ],
          "duplicate": true,
          "copy_from_site": true
        }
      ],
      "collapsible": false,
      "add_label": "Add new site"
    },
    {
      "id": "dr_site",
      "type": "choice",
      "label": "Which site is your DR (disaster recovery) site?",
      "options": [
        "No DR site",
        "Ofek",
        "Sapir",
        "Mazpen"
      ],
      "exclude": [
        "/primary_site"
      ]
    },
    {
      "id": "connections",
      "type": "list",
      "label": "Connections (port openings) between segments",
      "row_label": "Connection",
      "start_empty": true,
      "help": "For every port opening, pick the segments it is opened from and to, in any site. You can pick several on each side. Each segment shows its site in brackets.",
      "item": [
        {
          "id": "from",
          "type": "choice",
          "label": "From segments",
          "required": true,
          "multiple": true,
          "options_from": [
            {
              "path": "/segments.name",
              "label": "{value} ({site|primary_site})"
            },
            {
              "path": "/other_sites.segments.name",
              "label": "{value} ({site|primary_site})"
            }
          ],
          "help": "Pick one or more."
        },
        {
          "id": "to",
          "type": "choice",
          "label": "To segments",
          "required": true,
          "multiple": true,
          "differs_from": "from",
          "options_from": [
            {
              "path": "/segments.name",
              "label": "{value} ({site|primary_site})"
            },
            {
              "path": "/other_sites.segments.name",
              "label": "{value} ({site|primary_site})"
            }
          ],
          "options": [
            "All endpoints"
          ],
          "help": "Pick one or more (segments picked in From are not offered)."
        },
        {
          "id": "direction",
          "type": "choice",
          "label": "Who opens the connection?",
          "required": true,
          "options": [
            "Outgoing (\"From\" opens it)",
            "Incoming (\"To\" opens it)",
            "Both directions"
          ]
        },
        {
          "id": "protocol",
          "type": "text",
          "label": "Protocol",
          "required": true,
          "placeholder": "e.g. HTTPS"
        },
        {
          "id": "ports",
          "type": "text",
          "label": "Port numbers",
          "required": true,
          "placeholder": "e.g. 443, 8443",
          "help": "Separate several ports with commas."
        }
      ]
    }
  ]
}
